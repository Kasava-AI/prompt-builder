{
  "name": "@kasava/prompt-builder",
  "version": "0.3.0",
  "description": "A prompt ORM for TypeScript. Typed variables, a composable template tag, an inspectable AST, and pluggable output dialects.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "default": "./dist/presets.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest --typecheck.only run",
    "test:baseline": "UPDATE_CONSUMER_BASELINE=1 vitest run test/integration/consumer-baseline.test.ts",
    "prepare": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "prompt",
    "llm",
    "ai",
    "builder",
    "fluent",
    "anthropic",
    "claude",
    "openai",
    "prompt-engineering",
    "orm",
    "prompt-orm",
    "ast",
    "typescript"
  ],
  "author": "Kasava <hello@kasava.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasava-ai/prompt-builder.git"
  },
  "homepage": "https://github.com/kasava-ai/prompt-builder#readme",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "sideEffects": false
}
